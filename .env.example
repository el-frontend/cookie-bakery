# Cookie Chain network configuration.
# Copy to .env and adjust. All five are required — the app fails fast at
# startup with a readable message if any is missing.

VITE_RPC_URL=https://rpc.cookiescan.io
VITE_DAS_URL=https://api.cookiescan.io
VITE_EXPLORER_URL=https://cookiescan.io
VITE_BRIDGE_URL=https://hyperlane.cookiescan.io

# Wallet Standard chain identifier, shape `namespace:reference`.
# Discovery filters on `uiWallet.chains.includes(chain)`, so a value no wallet
# advertises produces an EMPTY WALLET LIST WITH NO ERROR.
# Any namespace is accepted, not just solana:* — the real value Nightly
# advertises for Cookie Chain is resolved by the RF-01.1 spike.
VITE_WALLET_CHAIN=solana:mainnet
