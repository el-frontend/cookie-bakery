{
  "name": "cookie-bakery",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "description": "Client-side token launcher and airdrop tool for Cookie Chain: create a Token-2022 mint, distribute it from a CSV in batches, and inspect holders.",
  "keywords": [
    "airdrop",
    "cookie-chain",
    "kit",
    "react",
    "solana-kit",
    "token-2022",
    "typescript",
    "vite"
  ],
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana-program/token-2022": "^0.16.1",
    "@solana/kit": "^8.2.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.19.0",
    "@solana/react": "^8.2.0",
    "@tailwindcss/vite": "^4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/el-frontend/cookie-bakery.git"
  },
  "homepage": "https://github.com/el-frontend/cookie-bakery#readme",
  "bugs": {
    "url": "https://github.com/el-frontend/cookie-bakery/issues"
  }
}
